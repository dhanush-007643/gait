# GaitInsight Environment Configuration
# Copy this file to .env and fill in your values.

# ── Demo Mode ──────────────────────────────────────────────────────────────
# Set to "true" to use synthetic mock data (no backend required).
# Set to "false" to connect to a real FastAPI backend.
VITE_USE_MOCK=true

# ── Backend API ────────────────────────────────────────────────────────────
# Base URL of your FastAPI / Flask backend (used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:5000

# ── App Meta ───────────────────────────────────────────────────────────────
VITE_APP_NAME=GaitInsight
VITE_APP_VERSION=1.0.0
